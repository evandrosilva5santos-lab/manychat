# Banco de dados (PostgreSQL — ex.: Supabase)
# Na Vercel com a integração Supabase, não precisa: ela cria POSTGRES_PRISMA_URL e
# POSTGRES_URL_NON_POOLING sozinha, e o app já lê esses nomes.
# Conexão usada pelo app (no Supabase: pooler, porta 6543)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
# Conexão direta usada pelas migrações (no Supabase: porta 5432)
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Senha do site (até o login da Etapa 6). Obrigatória na Vercel.
SITE_PASSWORD=""
SITE_USER="fluxo"
# Identidade do operador que acessa /admin com as credenciais acima.
SUPERADMIN_EMAIL="evandro@exemplo.com"
SUPERADMIN_NAME="Evandro"

# Meta / Instagram (Etapa 7) — NUNCA commite os valores reais.
# Coloque-os só no .env local (ignorado pelo git) e nas variáveis da Vercel.
# Há dois logins ("Entrar com Facebook" e "Entrar com Instagram"), cada um com
# o seu par de credenciais. Passo a passo em docs/etapa-7-meta-app.md (seção 2).
#
# App da Meta → usado pelo "Entrar com Facebook" (Facebook Login) e pelo webhook.
# Onde achar: developers.facebook.com › seu app › Configurações do app › Básico
# (ID do Aplicativo e Chave Secreta do Aplicativo).
META_APP_ID=""
META_APP_SECRET=""
# Opcional — Login do Facebook para Empresas: ID de uma "Configuração" criada em
# Login do Facebook para Empresas › Configurações. Se definido, substitui o scope.
META_LOGIN_CONFIG_ID=""
# App do Instagram → usado pelo "Entrar com Instagram" (API com login do Instagram).
# ATENÇÃO: é o ID do app do INSTAGRAM, DIFERENTE do META_APP_ID acima.
# Se os dois forem iguais, o login é recusado (a Meta responderia "Invalid platform app").
# Onde achar: seu app › Instagram › Configuração da API com login do Instagram ›
# 3. Configurar login comercial do Instagram › Configurações do login comercial.
IG_APP_ID=""
IG_APP_SECRET=""
# URL pública do Fluxo, com https e sem barra no final (ex.: https://seu-site.vercel.app).
# É a base da URL de retorno do OAuth: ${APP_URL}/api/auth/instagram/callback,
# que precisa estar cadastrada no Facebook Login E no login comercial do Instagram.
APP_URL=""
# Segredo para assinar o state do OAuth e os convites do /conectar (HMAC).
# Opcional: se ficar vazio, usa TOKEN_ENCRYPTION_KEY. Sem nenhum dos dois, o login é recusado.
# Precisa ser o mesmo em todos os ambientes que iniciam/recebem o login.
OAUTH_STATE_SECRET=""
# Token de acesso da conta profissional e o ID dela (só para testes manuais;
# o login pelo painel salva o token no banco)
IG_ACCESS_TOKEN=""
IG_USER_ID=""
# Texto qualquer que você inventa; a Meta repete ele ao validar o webhook
# (${APP_URL}/api/webhook/instagram, o mesmo para os dois logins)
WEBHOOK_VERIFY_TOKEN=""

# Segredo dos agendamentos (texto longo e aleatório, ex.: `openssl rand -hex 32`).
# Protege /api/webhook/instagram/tick (esperas e fila) e /api/cron/refresh-tokens.
# Em produção, sem ele o /tick responde 503. O mesmo valor vai no agendamento do
# QStash — passo a passo em docs/agendador-qstash.md.
CRON_SECRET=""

# Stripe (pagamentos) — NUNCA commite os valores reais; só no .env local
# e nas variáveis da Vercel. Chaves: Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_RESTRICTED_KEY=""
# Cadastro público em /cadastro (com teste grátis do plano). Fica fechado até
# valer "on": defina os preços e o Stripe em /admin/planos antes de abrir.
PUBLIC_SIGNUP=""
# Segredo de assinatura do webhook (whsec_...): Developers → Webhooks → endpoint
# ${APP_URL}/api/webhook/stripe com os eventos checkout.session.completed e
# customer.subscription.created/updated/deleted. Ative também o Customer Portal
# (Settings → Billing → Customer portal). Cada plano recebe o ID do preço (price_...)
# em /admin/planos; sem ele o plano não aparece no checkout.
STRIPE_WEBHOOK_SECRET=""
