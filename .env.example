# Banco de dados (PostgreSQL — ex.: Supabase)
# Na Vercel com a integração Supabase, não precisa: ela cria POSTGRES_PRISMA_URL e
# POSTGRES_URL_NON_POOLING sozinha, e o app já lê esses nomes.
# Conexão usada pelo app (no Supabase: pooler, porta 6543)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
# Conexão direta usada pelas migrações (no Supabase: porta 5432)
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Senha do site (até o login da Etapa 6). Obrigatória na Vercel.
SITE_PASSWORD=""
SITE_USER="fluxo"

# Meta / Instagram (Etapa 7) — NUNCA commite os valores reais.
# Coloque-os só no .env local (ignorado pelo git) e nas variáveis da Vercel.
# App da Meta (developers.facebook.com › seu app › Configurações › Básico)
META_APP_ID=""
META_APP_SECRET=""
# Produto Instagram (API com login do Instagram) — ID e chave secreta do app do Instagram
IG_APP_ID=""
IG_APP_SECRET=""
# Token de acesso da conta profissional e o ID dela
IG_ACCESS_TOKEN=""
IG_USER_ID=""
# Texto qualquer que você inventa; a Meta repete ele ao validar o webhook
WEBHOOK_VERIFY_TOKEN=""
