// Banco de dados do Fluxo.
// Explicação de cada tabela, em português simples: docs/etapa-1-banco.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// A URL de conexão fica em prisma.config.ts (lida do .env).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Conta do Instagram conectada (a "dona" de tudo abaixo)
// ─────────────────────────────────────────────────────────────

enum ConnectionStatus {
  CONNECTED // tudo certo
  EXPIRED // token da Meta venceu: automações pausadas até reconectar
  DISCONNECTED
}

/// Por qual login a conta entrou — define o host da Graph API e se o token renova.
enum AuthProvider {
  INSTAGRAM_LOGIN // token do Instagram Login → graph.instagram.com, renova a cada 60 dias
  FACEBOOK_LOGIN // token de Página do Facebook → graph.facebook.com, não expira
}

enum TokenStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  REVOKED
}

/// Papéis globais da plataforma. Apenas SUPERADMIN pode operar o painel
/// administrativo e realizar impersonação auditável de clientes.
enum UserRole {
  SUPERADMIN
  CLIENT
}

/// Pessoa autenticada no Fluxo. Clientes possuem workspaces próprios; a
/// agência usa SUPERADMIN para administrar todos os workspaces.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         UserRole @default(CLIENT)
  /// Hash scrypt da senha (formato `scrypt$salt$hash`). Vazio = só entra por convite/Super Admin.
  passwordHash String?
  createdAt    DateTime @default(now())

  workspacesOwned Workspace[]       @relation("WorkspaceOwner")
  sessions        UserSession[]
  memberships     WorkspaceMember[]
}

/// Limite de tenancy: um workspace pertence a um cliente e agrupa uma ou mais
/// contas do Instagram. Todos os dados operacionais continuam vinculados à
/// InstagramAccount para preservar o isolamento por conta.
model Workspace {
  id        String        @id @default(cuid())
  name      String
  ownerId   String
  kind      WorkspaceKind @default(CUSTOMER)
  createdAt DateTime      @default(now())

  owner        User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  accounts     InstagramAccount[]
  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  subscription Subscription?

  @@index([ownerId])
}

/// Sessão opaca: somente o hash do token vai para o banco. O token em texto
/// puro existe exclusivamente no cookie HTTP-only gerenciado pela autenticação.
model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Perfil profissional do Instagram ligado ao sistema.
/// Cada contato, etiqueta, fluxo e card pertence a uma conta — assim dá pra
/// atender mais de um perfil (agência) sem misturar dados.
model InstagramAccount {
  id             String           @id @default(cuid())
  workspaceId    String
  igUserId       String           @unique // ID da conta no Instagram (vem da Meta)
  username       String
  name           String?
  profilePicUrl  String?
  status         ConnectionStatus @default(CONNECTED)
  tokenStatus    TokenStatus?
  /// Token de acesso criptografado. Enquanto houver uma conta só, o token
  /// fica no .env (IG_ACCESS_TOKEN) e este campo fica vazio.
  accessTokenEnc String?
  tokenExpiresAt DateTime?
  authProvider   AuthProvider     @default(INSTAGRAM_LOGIN)
  fbPageId       String? // Página do Facebook (só FACEBOOK_LOGIN)
  /// ID app-scoped que a Meta manda no signed_request (Instagram: `id` de /me;
  /// Facebook: `id` do usuário). Casa os callbacks de desautorização/exclusão.
  metaUserId     String?
  /// Última conexão pelo OAuth: pedido da Meta emitido antes disso não se aplica.
  connectedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  contacts       Contact[]
  tags           Tag[]
  flows          Flow[]
  catalogItems   CatalogItem[]
  messages       Message[]
  trackedLinks   TrackedLink[]
  privateReplies PrivateReply[]

  @@index([workspaceId])
  @@index([metaUserId])
}

// ─────────────────────────────────────────────────────────────
// Contato e etiquetas
// ─────────────────────────────────────────────────────────────

/// A pessoa que conversou com você (comentou, mandou DM ou clicou num botão).
model Contact {
  id                 String    @id @default(cuid())
  accountId          String
  /// IGSID: o ID que o Instagram dá pra essa pessoa *dentro da sua conta*.
  igsid              String
  username           String?
  name               String?
  profilePicUrl      String?
  /// Segue o perfil? null = ainda não sabemos.
  followsAccount     Boolean?
  /// Última mensagem que ELA mandou. A Meta só deixa responder DM
  /// até 24h depois disso.
  lastInboundAt      DateTime?
  lastInteractionAt  DateTime?
  /// Fluxo pelo qual a pessoa entrou ("Entrou por" na lista de contatos).
  sourceFlowId       String?
  /// Prévia desnormalizada da última mensagem (evita 1 query por contato
  /// na lista de conversas).
  lastMessagePreview String?
  lastMessageAt      DateTime?
  /// Opt-out (LGPD): mandou "parar"/"sair"/"stop"/"cancelar" no Direct e não
  /// recebe nenhum envio automático até mandar "voltar".
  optedOut           Boolean   @default(false)
  optedOutAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceFlow   Flow?            @relation("ContactSource", fields: [sourceFlowId], references: [id], onDelete: SetNull)
  tags         ContactTag[]
  messages     Message[]
  runs         FlowRun[]
  trackedLinks TrackedLink[]

  @@unique([accountId, igsid]) // evita contato duplicado
  @@index([accountId, lastInteractionAt])
  @@index([sourceFlowId])
}

/// Etiqueta que você cola no contato ("lead-quente", "já-comprou").
model Tag {
  id        String   @id @default(cuid())
  accountId String
  name      String
  createdAt DateTime @default(now())

  account  InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([accountId, name])
}

/// Liga contato ↔ etiqueta (um contato tem várias etiquetas e
/// uma etiqueta está em vários contatos).
model ContactTag {
  contactId       String
  tagId           String
  /// Fluxo que aplicou a etiqueta (null = aplicada à mão no painel).
  appliedByFlowId String?
  createdAt       DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

// ─────────────────────────────────────────────────────────────
// Fluxo, caixinhas (nós) e linhas (arestas)
// ─────────────────────────────────────────────────────────────

enum FlowStatus {
  DRAFT // rascunho, nunca publicado
  LIVE // "Ao vivo": respondendo de verdade
  STOPPED // "Parado"
}

enum FlowMode {
  SIMPLE // builder simples (receita: gatilho → condição → mensagem)
  ADVANCED // builder avançado (canvas com caixinhas)
}

/// A automação em si ("Captação story", "Casamento por DM").
model Flow {
  id         String     @id @default(cuid())
  accountId  String
  name       String
  folder     String? // pasta do breadcrumb: Automações › pasta › nome
  status     FlowStatus @default(DRAFT)
  mode       FlowMode   @default(ADVANCED)
  /// Zoom e posição da tela do editor, pra reabrir do mesmo jeito.
  viewport   Json?
  /// Receita do builder simples (só quando mode = SIMPLE). As caixinhas
  /// são geradas a partir dela a cada salvamento.
  recipe     Json?
  /// Soft-delete: fluxo arquivado mantém o histórico (FlowRun, Message).
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  account          InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nodes            Node[]
  edges            Edge[]
  triggers         Trigger[]
  runs             FlowRun[]
  messages         Message[]
  contactsAcquired Contact[]        @relation("ContactSource")
  trackedLinks     TrackedLink[]

  @@index([accountId, status])
}

/// Link rastreado: botões com URL apontam para /api/l/{code}, que conta o
/// clique e redireciona só para a URL salva aqui (nunca para uma URL da query).
model TrackedLink {
  id             String    @id @default(cuid())
  accountId      String
  /// Código aleatório e público usado na URL /api/l/{code}.
  code           String    @unique
  /// Destino final (somente https).
  url            String
  contactId      String?
  flowId         String?
  /// Caixinha que gerou o link. Sem chave estrangeira porque as caixinhas do
  /// builder simples são recriadas a cada salvamento.
  nodeId         String?
  clicks         Int       @default(0)
  firstClickedAt DateTime?
  lastClickedAt  DateTime?
  createdAt      DateTime  @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  flow    Flow?            @relation(fields: [flowId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([contactId, nodeId])
  @@index([flowId])
}

enum NodeType {
  MESSAGE // mensagem de texto
  QUESTION // mensagem com 1 a 3 botões fixos; cada botão é uma saída
  CONDITION // if/else: saída "yes" e saída "no"
  DELAY // esperar um tempo
  ADD_TAG // colocar etiqueta no contato
  CAROUSEL // carrossel de cards do catálogo
  FOLLOW_GATE // "confirme que segue" com botão DESBLOQUEAR
  NOTE // anotação no canvas, não executa nada
}

/// Uma caixinha do fluxo. O que vai dentro depende do tipo e fica em `data`:
///   MESSAGE      { text }
///   QUESTION     { text, buttons: [{ id, title, type: "postback" | "web_url", url? }] }  // máx. 3
///   CONDITION    { rule: "follows" | "has_tag" | "reply_contains", tagId?, value? }
///   DELAY        { seconds }
///   ADD_TAG      { tagId }
///   CAROUSEL     {} — os cards ficam na tabela CarouselCard
///   FOLLOW_GATE  { text, buttonTitle: "DESBLOQUEAR", notFollowingText }
///   NOTE         { text }
/// O `id` é o mesmo usado pelo React Flow na tela.
model Node {
  id        String   @id @default(cuid())
  flowId    String
  type      NodeType
  name      String? // nome editável ("Mensagem #1")
  positionX Float
  positionY Float
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flow          Flow           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  outgoing      Edge[]         @relation("EdgeSource")
  incoming      Edge[]         @relation("EdgeTarget")
  carouselCards CarouselCard[]
  startsFrom    Trigger[]      @relation("TriggerStart")
  runsHere      FlowRun[]
  messages      Message[]

  @@index([flowId])
}

/// A linha que liga uma caixinha na próxima.
/// `sourceHandle` diz de QUAL saída ela sai: o id do botão, o id do card
/// do carrossel, "yes"/"no" na condição, "unlock" no FOLLOW_GATE. null = saída única.
model Edge {
  id           String  @id @default(cuid())
  flowId       String
  sourceNodeId String
  sourceHandle String?
  targetNodeId String

  flow   Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  source Node @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target Node @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  // Unicidade garantida por índices únicos PARCIAIS criados via SQL na
  // migration (o @@unique do Prisma trata NULLs como distintos, o que
  // permitia duplicar arestas sem handle).
  @@index([flowId])
}

// ─────────────────────────────────────────────────────────────
// Gatilho
// ─────────────────────────────────────────────────────────────

enum TriggerType {
  COMMENT_KEYWORD // palavra-chave em comentário de post/reel
  DM_KEYWORD // palavra-chave em DM
  STORY_REPLY // resposta a um story
  BUTTON_CLICK // clique num botão (payload)
}

enum KeywordMatch {
  CONTAINS // a mensagem contém a palavra
  EXACT // a mensagem é exatamente a palavra
  ANY // qualquer mensagem serve
}

/// O que faz o fluxo começar.
model Trigger {
  id               String       @id @default(cuid())
  flowId           String
  type             TriggerType
  keywords         String[] // ["casamento", "eu quero"]
  negativeKeywords String[]     @default([])
  cooldownSeconds  Int          @default(0)
  priority         Int          @default(0)
  match            KeywordMatch @default(CONTAINS)
  /// Post/reel/story específico. null = vale pra qualquer publicação.
  mediaId          String?
  /// Payload do botão (só para BUTTON_CLICK).
  payload          String?
  /// Respostas públicas no comentário (até 5); o motor sorteia uma.
  publicReplies    String[]     @default([])
  /// Caixinha onde o fluxo começa. null = a primeira sem linha chegando.
  startNodeId      String?
  /// Posição da caixinha de gatilho no editor.
  positionX        Float        @default(0)
  positionY        Float        @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  flow      Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  startNode Node?     @relation("TriggerStart", fields: [startNodeId], references: [id], onDelete: SetNull)
  runs      FlowRun[]

  @@index([flowId])
  @@index([type])
  @@index([startNodeId])
  @@index([type, mediaId])
}

// ─────────────────────────────────────────────────────────────
// Execução do fluxo (o "motor" usa na Etapa 3)
// ─────────────────────────────────────────────────────────────

enum RunStatus {
  RUNNING
  WAITING_REPLY // private reply enviada, aguardando mensagem do contato
  WAITING_DELAY // parado numa Espera, volta em `resumeAt`
  WAITING_CLICK // mandou botões e espera o clique
  DONE
  FAILED
}

/// Uma "passada" de um contato por um fluxo. Guarda onde ele está,
/// pra continuar depois de uma espera ou de um clique.
/// Regra de unicidade (SQL na migration): no máximo UM run ativo por
/// (contactId, flowId) — índice único parcial em RUNNING/WAITING_*.
model FlowRun {
  id             String    @id @default(cuid())
  flowId         String
  contactId      String
  triggerId      String?
  status         RunStatus @default(RUNNING)
  currentNodeId  String?
  triggerContext Json?
  resumeAt       DateTime?
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  flow        Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  trigger     Trigger?  @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  currentNode Node?     @relation(fields: [currentNodeId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([status, resumeAt])
  @@index([contactId, status])
  @@index([contactId, currentNodeId, status])
  @@index([flowId])
  @@index([triggerId])
  @@index([currentNodeId])
}

// ─────────────────────────────────────────────────────────────
// Histórico de conversa
// ─────────────────────────────────────────────────────────────

enum Direction {
  IN // o contato mandou
  OUT // o sistema mandou
}

enum MessageKind {
  TEXT
  BUTTONS // button template (botões fixos)
  CAROUSEL // generic template (cards)
  POSTBACK // clique num botão
  COMMENT // comentário num post/reel
  COMMENT_REPLY // resposta pública ao comentário
  STORY_REPLY
  MEDIA // imagem, áudio, vídeo
}

/// Tudo que já foi trocado com um contato, na ordem.
model Message {
  id          String      @id @default(cuid())
  accountId   String
  contactId   String
  direction   Direction
  kind        MessageKind
  text        String?
  /// Conteúdo completo (botões, cards, anexo, payload do clique).
  payload     Json?
  /// ID da mensagem/comentário no Instagram — evita gravar o mesmo evento 2x.
  igMessageId String?     @unique
  mediaId     String? // post/reel/story relacionado
  flowId      String?
  nodeId      String?
  runId       String?
  error       String? // se a Meta recusou o envio
  createdAt   DateTime    @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  flow    Flow?            @relation(fields: [flowId], references: [id], onDelete: SetNull)
  node    Node?            @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  run     FlowRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([flowId, createdAt])
  @@index([accountId, createdAt])
  @@index([runId])
  @@index([nodeId])
}

// ─────────────────────────────────────────────────────────────
// Fila de eventos do webhook (idempotência + retentativas)
// ─────────────────────────────────────────────────────────────

enum WebhookEventStatus {
  RECEIVED // gravado, aguardando processamento (ou backoff de retentativa)
  PROCESSING // reivindicado por um worker
  DONE // processado com sucesso
  FAILED // erro permanente: não será retentado
  DEAD // esgotou as retentativas
}

/// Cada evento entregue pela Meta vira uma linha aqui ANTES de qualquer
/// processamento. `idempotencyKey` único garante processamento exatamente
/// uma vez (entrega duplicada → P2002 → resposta 200 imediata).
model WebhookEvent {
  id             String             @id @default(cuid())
  /// Conta destinatária (resolvida do entry.id no processamento; null se
  /// a conta ainda não existia).
  accountId      String?
  /// igUserId:commentId | igUserId:messageMid | igUserId:postbackMid | hash
  idempotencyKey String             @unique
  /// comment | message | postback
  type           String
  /// Evento normalizado (NormalizedWebhookEvent) completo.
  payload        Json
  status         WebhookEventStatus @default(RECEIVED)
  attempts       Int                @default(0)
  lastError      String?
  receivedAt     DateTime           @default(now())
  claimedAt      DateTime?
  /// Quando a próxima tentativa pode rodar (backoff exponencial).
  nextAttemptAt  DateTime           @default(now())
  processedAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────
// Exclusão de dados (callback da Meta e "Excluir perfil e dados")
// ─────────────────────────────────────────────────────────────

enum DeletionSource {
  META_CALLBACK
  APP
}

/// PERSON: só os dados da pessoa (credencial e IDs da Meta). BUSINESS: o perfil
/// profissional inteiro (contatos, conversas, fluxos…).
enum DeletionScope {
  PERSON
  BUSINESS
}

enum DeletionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Pedido de exclusão rastreável pelo código mostrado em /exclusao-de-dados.
/// Guarda só o hash do ID da Meta, nunca o ID.
model DataDeletionRequest {
  id               String         @id @default(cuid())
  /// 128 bits em base64url — é o confirmation_code devolvido à Meta.
  code             String         @unique
  /// SHA-256 do signed_request (repetição da Meta devolve o mesmo pedido)
  /// ou `app:{accountId}:{timestamp}` no pedido feito pelo app.
  requestKey       String         @unique
  source           DeletionSource
  provider         AuthProvider?
  metaUserIdHash   String?
  scope            DeletionScope
  accountIds       String[]
  status           DeletionStatus @default(PENDING)
  accountsAffected Int            @default(0)
  attempts         Int            @default(0)
  /// Motivo da falha, sem dado pessoal.
  lastError        String?
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Catálogo de cards (reutilizável)
// ─────────────────────────────────────────────────────────────

enum CardButtonType {
  URL // link externo
  POSTBACK // próximo passo do fluxo
}

/// Card reutilizável: imagem + título + descrição + botão.
/// Edita aqui e todo carrossel que usa o card é atualizado.
model CatalogItem {
  id          String         @id @default(cuid())
  accountId   String
  title       String // máx. 80 caracteres
  description String? // máx. 80 caracteres
  imageUrl    String // 1080×1080 recomendado
  buttonTitle String // curto, ≈20 caracteres, em CAIXA ALTA
  buttonType  CardButtonType @default(URL)
  buttonUrl   String? // só quando buttonType = URL
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usages  CarouselCard[]

  @@index([accountId])
}

/// Qual card aparece em qual carrossel, e em que ordem (máx. 10 por carrossel).
/// Um card em uso não pode ser apagado (onDelete: Restrict).
/// Botões POSTBACK saem do nó pelo handle = id desta linha.
model CarouselCard {
  id            String @id @default(cuid())
  nodeId        String
  catalogItemId String
  position      Int

  node        Node        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([nodeId, position])
  @@index([catalogItemId])
}

// Claim durável antes de enviar; erro ambíguo não autoriza uma segunda private reply.
model PrivateReply {
  id        String   @id @default(cuid())
  accountId String
  commentId String
  claimedAt DateTime @default(now())
  messageId String?

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, commentId])
}

// ─────────────────────────────────────────────────────────────
// Equipe, planos e cobrança (ADR-008)
// ─────────────────────────────────────────────────────────────

/// Papel dentro de um workspace. Independe do papel global (`UserRole`).
enum WorkspaceRole {
  OWNER // dono: plano, cobrança e equipe
  ADMIN // configura tudo, menos cobrança
  OPERATOR // atende: conversas e contatos
}

enum WorkspaceKind {
  CUSTOMER // cliente: segue o plano
  INTERNAL // operação da Start Inc: sem limites e fora do MRR
}

enum SubscriptionStatus {
  TRIALING // teste grátis até `trialEndsAt`
  ACTIVE
  PAST_DUE // pagamento falhou: funciona até `graceEndsAt`
  SUSPENDED // automações pausadas; dados preservados
  CANCELED
}

/// Como o cliente paga (ADR-009).
enum BillingMode {
  STRIPE // cartão recorrente pelo Stripe
  MANUAL // Pix, boleto ou transferência, registrado pelo Super Admin
  COMPLIMENTARY // cortesia
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  CARD
  PIX
  BOLETO
  TRANSFER
  CASH
  OTHER
}

/// Quem pode entrar em qual workspace, e com qual papel.
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Convite por link: só o hash do token vai para o banco; vale uma vez.
model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Plano à venda. Limite `null` = ilimitado (decisão explícita).
/// `features` é a lista do que está liberado: o que não está nela fica bloqueado.
model Plan {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  description          String?
  isPublic             Boolean  @default(true)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  priceMonthlyCents    Int      @default(0)
  /// Preço anual (cobrado de uma vez). Vazio = plano só mensal.
  priceYearlyCents     Int?
  currency             String   @default("brl")
  trialDays            Int      @default(0)
  graceDays            Int      @default(7)
  /// Preço recorrente no Stripe. Sem ele, o plano não aparece no checkout.
  stripePriceId        String?  @unique
  stripeYearlyPriceId  String?  @unique
  maxInstagramAccounts Int?
  maxMembers           Int?
  maxActiveFlows       Int?
  maxDmsPerMonth       Int?
  features             String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
}

/// Única fonte do plano e do status de cada workspace.
model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  planId               String
  status               SubscriptionStatus
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  /// Fim da carência quando o pagamento falha (PAST_DUE).
  graceEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  /// Ajustes negociados com este cliente, ex.: { "maxInstagramAccounts": 5 }.
  limitOverrides       Json               @default("{}")
  /// Cortesia: cliente grátis, sem cobrança e fora do MRR. Ao vencer, suspende.
  isComplimentary      Boolean            @default(false)
  /// Fim da cortesia; vazio = por tempo indeterminado.
  complimentaryUntil   DateTime?
  billingMode          BillingMode        @default(STRIPE)
  billingCycle         BillingCycle       @default(MONTHLY)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  SubscriptionPayment[]

  @@index([planId])
}

/// Pagamento recebido: registrado à mão (Pix, boleto…) ou vindo do Stripe.
model SubscriptionPayment {
  id              String        @id @default(cuid())
  subscriptionId  String
  workspaceId     String
  amountCents     Int
  currency        String        @default("brl")
  method          PaymentMethod
  paidAt          DateTime
  periodStart     DateTime
  periodEnd       DateTime
  reference       String?
  notes           String?
  /// manual | stripe
  source          String        @default("manual")
  /// Fatura do Stripe (evita gravar o mesmo pagamento duas vezes).
  stripeInvoiceId String?       @unique
  recordedById    String?
  createdAt       DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, paidAt])
  @@index([paidAt])
}

/// Trilha das ações administrativas. Gravada na mesma transação da ação.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  changes     Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

/// Eventos do Stripe já processados (idempotência do webhook).
model BillingEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
